#!/bin/bash

# Verify the page's local references before it is published:
#   - every `?asset=<12 hex>` query is the first 12 hex characters of the
#     SHA-256 of the file it is attached to, so a changed file always gets a
#     new URL;
#   - every local file the page links, loads or lists in a srcset exists.
#
# Usage: bin/check-asset-hashes [page ...]   (default: index.html)

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$ROOT"

digest() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -- "$1" | cut -c1-12
  else
    shasum -a 256 -- "$1" | cut -c1-12
  fi
}

(($# > 0)) || set -- index.html
failures=0
hashed=0
checked=0

report() {
  printf 'FAIL: %s\n' "$*" >&2
  failures=$((failures + 1))
}

check_reference() {
  local page=$1 reference=$2 path query expected actual

  case $reference in
    '' | '#'* | *://* | //* | mailto:* | data:*) return 0 ;;
  esac
  path=${reference%%[?#]*}
  [[ -n $path ]] || return 0
  query=""
  [[ $reference == *\?* ]] && query=${reference#*\?}
  query=${query%%#*}
  checked=$((checked + 1))

  if [[ ! -f $path ]]; then
    report "$page references a missing file: $reference"
    return 0
  fi
  if [[ $query =~ (^|&)asset=([^&]*) ]]; then
    expected=${BASH_REMATCH[2]}
    actual=$(digest "$path")
    hashed=$((hashed + 1))
    if [[ $expected != "$actual" ]]; then
      report "$page: $path is $actual but the page says asset=$expected"
    fi
  fi
}

for page in "$@"; do
  [[ -f $page ]] || {
    report "page not found: $page"
    continue
  }
  while IFS= read -r reference; do
    check_reference "$page" "$reference"
  done < <(
    {
      grep -oE '(src|href)="[^"]*"' "$page" | sed -E 's/^[a-z]+="//; s/"$//'
      # A srcset is a comma-separated list of "<url> <descriptor>".
      grep -oE 'srcset="[^"]*"' "$page" | sed -E 's/^srcset="//; s/"$//' |
        tr ',' '\n' | awk '{print $1}'
    } | sort -u
  )
done

if ((hashed == 0)); then
  report "no ?asset= references were found; the check no longer matches the page"
fi
if ((failures > 0)); then
  printf '%d problem(s) in %d local reference(s).\n' "$failures" "$checked" >&2
  exit 1
fi
printf 'OK: %d local reference(s) exist, %d asset hash(es) match.\n' "$checked" "$hashed"
